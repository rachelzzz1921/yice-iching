# 前端 API 地址（开发默认指向本地后端）
# 开发走 vite 代理 /api → backend:3001；直连后端可改为 http://localhost:3001
VITE_API_URL=/api

# 可选：云端 AI（海外顶级大模型，内部对接）
# - 正式路径：仅润色本地解读「分析」段
# - 深入追问：仅 AI 回答（必须配置 Key，无本地模板兜底）
# 密钥变量名保留 ZHIPU_* 以兼容现有部署
# ZHIPU_API_KEY=
# ZHIPU_MODEL=glm-4.5-air
# 全 AI 解读 / 润色 / 追问 默认用 glm-4-flash（比 4.5-air 快数倍）
# ZHIPU_FULL_AI_MODEL=glm-4-flash
# ZHIPU_FULL_AI_MAX_TOKENS=1600
# ZHIPU_FULL_AI_TIMEOUT_MS=55000
# ZHIPU_FULL_AI_CACHE_TTL_MS=3600000
# 设为 1 时，正式解读会等智谱润色（较慢）；默认 0 秒出本地解读
# ZHIPU_POLISH_ON_LOAD=0
