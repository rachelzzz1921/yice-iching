# 服务
PORT=3001
CORS_ORIGIN=http://localhost:8080

# 数据库（本地 Docker 见 docker-compose.yml；上线改为阿里云 RDS 内网地址）
DATABASE_URL=postgresql://iching:iching@localhost:5432/iching

# Redis（可选；无则跳过 AI 缓存）
REDIS_URL=redis://localhost:6379
# AI 缓存 TTL（秒）
AI_CACHE_TTL_SEC=86400
FOLLOWUP_CACHE_TTL_SEC=3600
# AI / 路由超时（毫秒）
AI_INTERPRET_TIMEOUT_MS=120000
AI_FOLLOWUP_TIMEOUT_MS=90000
AI_ROUTE_TIMEOUT_MS=130000
# Postgres 连接池
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000
# 请求日志（0=关闭慢请求日志）
# LOG_REQUESTS=0

# JWT（上线务必改为随机长字符串）
JWT_SECRET=change-me-in-production

# 管理接口密钥（初始化数据库用）
ADMIN_KEY=change-me-admin-key

# 管理后台登录密码（/admin 页面）
ADMIN_PASSWORD=change-me-admin-password

# 管理后台「启动数据库」使用的 docker-compose 目录（默认仓库根目录）
# ICHING_COMPOSE_DIR=/path/to/code

# 解读引擎：默认本地卦辞库（iching-oracle 打包 interpret.bundle.cjs）
# 可选智谱 GLM 仅润色「分析」段（不替代起卦）；未配置则纯本地
# 测试板块：结果页下方「智谱完整生成」对比区（需同一 ZHIPU_API_KEY）
# 控制台：https://open.bigmodel.cn/
# 留空则自动从 ../iching-oracle/.env 或 ../deploy/.env.prod 读取（勿写 ZHIPU_API_KEY= 空行）
# ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.5-air

# 微信支付 API v3（Native 扫码 + 微信内 JSAPI）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_MCH_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=   # apiclient_key.pem 全文，换行用 \n
# WECHAT_OAUTH_SECRET=      # 公众号 AppSecret（微信内网页授权 openid）
# WECHAT_PAY_NOTIFY_URL=https://你的域名/api/wechat/pay/notify
# WECHAT_PAY_PUBLIC_BASE_URL=https://你的域名
# SINGLE_DIVINATION_PRICE_CENTS=100
# MEMBERSHIP_LIFETIME_PRICE_CENTS=990
# ALLOW_MOCK_PAY=1

# 旧版通义千问（已弃用，解读改走本地+智谱）
# DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
