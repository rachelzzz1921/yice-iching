# 复制为 deploy/.env.prod 并填写（deploy.sh 可自动生成部分字段）
POSTGRES_PASSWORD=请改为随机长密码
JWT_SECRET=请改为随机长字符串
ADMIN_KEY=请改为随机字符串
ADMIN_PASSWORD=请改为管理后台登录密码

# 硅基流动 DeepSeek V4（可选：润色 / 追问 / 全 AI 解读；未填则纯本地解读）
# 控制台：https://cloud.siliconflow.cn/
# 注意：解卦在「前端 SSR 容器」里跑，此变量会注入 frontend + backend
STEP_API_KEY=
STEP_API_URL=https://api.siliconflow.cn/v1/chat/completions
STEP_MODEL=deepseek-ai/DeepSeek-V4-Flash
STEP_FULL_AI_MODEL=deepseek-ai/DeepSeek-V4-Pro
# 旧变量名保留给历史代码/脚本兼容
ZHIPU_API_KEY=
ZHIPU_MODEL=deepseek-ai/DeepSeek-V4-Flash
ZHIPU_FULL_AI_MODEL=deepseek-ai/DeepSeek-V4-Pro

# 浏览器访问地址（有域名后改成 https://yourdomain.com）
CORS_ORIGIN=http://你的公网IP
PORT=3001
ALLOW_MOCK_PAY=0

# 微信支付（须 HTTPS 域名）
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_MCH_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_OAUTH_SECRET=
# WECHAT_PAY_NOTIFY_URL=https://你的域名/api/wechat/pay/notify
# WECHAT_PAY_PUBLIC_BASE_URL=https://你的域名
SINGLE_DIVINATION_PRICE_CENTS=100
MEMBERSHIP_LIFETIME_PRICE_CENTS=990
